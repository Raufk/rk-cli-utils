#!/usr/bin/env bash
set -euo pipefail

# =========== utils ===========
require_cmd() {
    command -v "$1" >/dev/null || {
        echo "Error: $1 is required"
        exit 1
    }
}

die() {
    echo "Error: $1"
    exit 1
}

# =========== dependency check ===========
for cmd in git curl jq ssh-keyscan; do
    require_cmd "$cmd"
done

# =========== CLI parsing ===========
usage() {
    cat <<EOF
Usage:
    rk setup-ssh --email <email> --user <user> --key-file <file> [--host github.example.com]
    setup-ssh --email <email> --user <user> --key-file <file> [--host github.example.com]

    rk slack-send --token <token> --channel <channel[,channel2]> --message <msg> [--color good|warning|danger|#hex]
    slack-send --token <token> --channel <channel[,channel2]> --message <msg> [--color good|warning|danger|#hex]

    rk get-slack-id --email <email> --token <token>
    get-slack-id --email <email> --token <token>

    rk git-app <clone|add|commit|fetch|pull|push|token> [args]   (GitHub App token auth)
    git-app <clone|add|commit|fetch|pull|push|token> [args]
    rk git-app help
EOF
    exit 0
}

main() {
    case "$cmd" in
        setup-ssh)
            local email="" user="" key="" host=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --user)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--user requires value"
                        user="$2"; shift 2 ;;
                    --email)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--email requires value"
                        email="$2"; shift 2 ;;
                    --key-file)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--key-file requires value"
                        key="$2"; shift 2 ;;
                    --host)
                        if [[ $# -ge 2 && -n "${2:-}" && "$2" != --* ]]; then
                            host="$2"; shift 2
                        else
                            echo "Warning: --host provided without value, ignoring" >&2
                            shift 1
                        fi
                        ;;
                    *)
                        usage ;;
                esac
            done
            source $SCRIPT_DIR/ssh.sh
            setup_ssh "${user:-}" "${email:-}" "${key:-}" "${host:-}"
            ;;
        slack-send)
            local token="" channel="" message="" color=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --color)
                        if [[ $# -ge 2 && -n "${2:-}" && "$2" != --* ]]; then
                            color="$2"; shift 2
                        else
                            echo "Warning: --color provided without value, ignoring" >&2
                            shift 1
                        fi
                        ;;
                    --channel)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--channel requires value"
                        channel="$2"; shift 2 ;;
                    --message)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--message requires value"
                        message="$2"; shift 2 ;;
                    --token)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--token requires value"
                        token="$2"; shift 2 ;;
                    *)
                        usage ;;
                esac
            done
            source $SCRIPT_DIR/slack.sh
            slack_send "${color:-good}" "$channel" "$message" "$token"
            ;;
        get-slack-id)
            local email="" token=""
            while [[ $# -gt 0 ]]; do
                case "$1" in
                    --email)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--email requires value"
                        email="$2"; shift 2 ;;
                    --token)
                        [[ $# -ge 2 && -n "${2:-}" ]] || die "--token requires value"
                        token="$2"; shift 2 ;;
                    *)
                        usage ;;
                esac
            done
            source $SCRIPT_DIR/slack.sh
            get_slack_user_id "$email" "$token"
            ;;
        git-app)
            source "$SCRIPT_DIR/git.sh"
            git_app "$@"
            ;;
        --version|-v)
            printf "\nRK Cli Utils -\n  Version : %s\n  Maintainer : Rauf K (abdulraufkc111@gmail.com)\n\n" "$VERSION"
            exit 0
            ;;
        --help|-h|"")
            usage ;;
        *)
            usage ;;
    esac
}

# =========== main ===========
cmd="${1:-}"
shift || true

VERSION="@VERSION@"
SCRIPT_DIR="/usr/lib/rk-cli-utils"

main "$@"
